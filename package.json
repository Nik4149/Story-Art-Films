{
  "name": "lumora-photography",
  "version": "1.0.0",
  "description": "Lumora Photography — Full Stack Application (React + Node.js + MongoDB)",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"yellow.bold,cyan.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "install:all": "npm install && cd client && npm install && cd ../server && npm install",
    "seed:admin": "cd server && node utils/seedAdmin.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
