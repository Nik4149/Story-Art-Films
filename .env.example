# ══════════════════════════════════════════════════════
#  Lumora Photography — Environment Variables
#  1. Copy this file:   cp .env.example .env
#  2. Fill in values below
#  3. NEVER commit .env to Git
# ══════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────
# Local:
MONGODB_URI=mongodb://localhost:27017/lumora_photography
# Atlas (production):
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/lumora_photography

# ── JWT ───────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_64_char_random_hex_string
JWT_EXPIRE=7d

# ── Cloudinary ────────────────────────────────────────
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email (Gmail SMTP) ────────────────────────────────
# Use an App Password, not your Gmail password
# https://myaccount.google.com/apppasswords
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASSWORD=your_16_char_app_password
ADMIN_EMAIL=admin@lumoraphotography.com

# ── Frontend ──────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── First Admin (used by seed:admin script) ───────────
ADMIN_NAME=Alex Lumora
ADMIN_EMAIL_SEED=admin@lumoraphotography.com
ADMIN_PASSWORD=ChangeMe@2026
